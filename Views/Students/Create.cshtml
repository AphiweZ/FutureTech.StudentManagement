@model CreateStudentViewModel
@{
    ViewData["Title"] = "Add Student";
}

<div class="content-wrapper fade-in">

    <div class="breadcrumb">
        <a asp-action="Index">Students</a>
        <i class="fas fa-chevron-right"></i>
        <span>Add Student</span>
    </div>

    <div class="section-header">
        <h2><i class="fas fa-user-plus"></i> Add New Student</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4"></div>

            <div class="form-section">
                <h3><i class="fas fa-id-card"></i> Student Information</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FirstName">
                            <i class="fas fa-user"></i> First Name
                        </label>
                        <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName">
                            <i class="fas fa-user"></i> Last Name
                        </label>
                        <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Email">
                            <i class="fas fa-envelope"></i> Email Address
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="student@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MobileNumber">
                            <i class="fas fa-phone"></i> Mobile Number
                        </label>
                        <input asp-for="MobileNumber" class="form-control" placeholder="+1234567890" />
                        <span asp-validation-for="MobileNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="EnrolmentStatus">
                            <i class="fas fa-user-check"></i> Enrolment Status
                        </label>
                        <select asp-for="EnrolmentStatus" class="form-control"
                                asp-items="Html.GetEnumSelectList<EnrolmentStatus>()"></select>
                        <span asp-validation-for="EnrolmentStatus" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3><i class="fas fa-image"></i> Profile Image</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ProfileImage">
                            <i class="fas fa-upload"></i> Upload Student Photo
                        </label>
                        <input asp-for="ProfileImage" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                        <p class="mb-0" style="font-size: 0.875rem;">
                            JPEG or PNG only, max 5MB. Images are resized automatically to 800px max.
                        </p>
                        <span asp-validation-for="ProfileImage" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Save Student
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}